APP_ENV=development
LOG_LEVEL=INFO

# --- Gemini (Part 5) ---
# Get a key at https://aistudio.google.com/apikey . Never commit the real key.
GEMINI_API_KEY=
# Recommended for new projects as of Oct 2026. Check https://ai.google.dev/gemini-api/docs/deprecations
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30
# Optional: LOW, MEDIUM or HIGH (leave commented to use the model default)
# GEMINI_THINKING_LEVEL=LOW

# Tutor endpoint limit per client IP (in-memory, per server process)
TUTOR_RATE_LIMIT_PER_MINUTE=20
MAX_VIDEO_UPLOAD_MB=100
MAX_VIDEO_DURATION_SECONDS=45
MAX_VIDEO_DECODED_FRAMES=5000
MAX_VIDEO_FRAME_PIXELS=2073600

# Development only: use clearly-labelled MOCK evaluation results (no real MLP/DTW module yet).
# Keep false in production.
USE_MOCK_EVALUATION=false

# Browser origins allowed to call the API (comma separated). Add your deployed frontend URL.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Matches docker-compose.yml (local development only)
DATABASE_URL=postgresql+psycopg://nrityaguru:change_me_local_only@localhost:5432/nrityaguru

# Optional, server-side authorization token for importing reference sequences.
# Configure only for a trusted reviewer workflow; never expose it in frontend variables.
REFERENCE_REVIEW_TOKEN=
REFERENCE_REVIEWER_IDENTITY=

# Optional evaluator artifacts; neither file is included in this repository.
NRITYAGURU_HAND_TASK=
NRITYAGURU_MLP_BUNDLE=
EVALUATION_RUNTIME_VERIFIED=false

# Development only: lets the API return source_cited/unverified records (clearly labelled).
# Keep false in production.
ALLOW_UNVERIFIED_RECORDS=true
