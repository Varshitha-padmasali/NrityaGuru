# Copy this file to .env.local and adjust. NEXT_PUBLIC_* values are visible in
# the browser — never put secrets (e.g. the Gemini API key) in this file.

# FastAPI backend URL (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Development-only placeholder data when the backend isn't ready.
# Keep "false" for demos, screenshots and evaluation.
NEXT_PUBLIC_USE_MOCK_API=false

# Browser recording limits; server upload/evaluation endpoints are not implemented yet.
NEXT_PUBLIC_MAX_RECORDING_SECONDS=8
NEXT_PUBLIC_MAX_UPLOAD_MB=10

# Timeouts (milliseconds)
NEXT_PUBLIC_REQUEST_TIMEOUT_MS=20000
NEXT_PUBLIC_LONG_REQUEST_TIMEOUT_MS=120000
NEXT_PUBLIC_EVALUATION_POLL_TIMEOUT_MS=90000

# ── Gemini image generation (SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_) ──
# Used by `npm run images:generate` and the /studio page (development only).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the image model (default gemini-nano-banana-2.1)
GEMINI_IMAGE_MODEL=
